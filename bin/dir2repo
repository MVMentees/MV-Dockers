#!/bin/bash
set -euo pipefail

if [ $# -ne 1 ]; then
    echo "Usage: $(basename "$0") <directory>"
    printf "\nMoves dir from PBD/PICKLE account to repo and puts\n"
    printf "a symbolic link in the account directory\n\n"
    exit 1
fi

DIR="$1"

SRC_ROOT="$HOME/PBD/PICKLE"
REPO_ROOT="$HOME/Pickleball"

SRC_DIR="${SRC_ROOT}/${DIR}"
REPO_DIR="${REPO_ROOT}/${DIR}"

# Verify source directory exists

if [ ! -d "$SRC_DIR" ]; then
    echo "ERROR: Source directory does not exist:"
    echo "  $SRC_DIR"
    exit 1
fi

# Verify destination does not already exist

if [ -e "$REPO_DIR" ]; then
    echo "ERROR: Destination already exists:"
    echo "  $REPO_DIR"
    exit 1
fi

echo "Moving:"
echo "  $SRC_DIR"
echo "to"
echo "  $REPO_DIR"

sudo mv "$SRC_DIR" "$REPO_DIR"

echo "Creating symbolic link:"
echo "  $SRC_DIR -> $REPO_DIR"

ln -s "$REPO_DIR" "$SRC_DIR"

echo "Done."
