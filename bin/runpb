#!/bin/bash

  running=`docker container list | grep universe-pickleball:latest`
  if [ ! -z "$running" ]; then
    printf "\n\nPickleball container already running\n"
    echo $running
    exit 1
  fi

  nohup docker run -it \
   -p2223:23 -p32438:31438 -p50000-50010:50000-50010\
   --rm -v /home/dockeradmin/PBD:/mystuff:z\
   -v /home/dockeradmin/Pickleball:/home/dockeradmin/Pickleball:z\
   universe-pickleball:latest > /home/dockeradmin/runpb_output 2> /dev/null &
#
  printf "\nPickleball container should be running.\n"
  printf "telnet localhost 2223 to access\n"
  printf "and/or use VSCODE with port 32348\n\n"
