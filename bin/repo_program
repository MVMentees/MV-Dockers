      tcl_stmt = @SENTENCE
      repo_verb = FIELD(tcl_stmt,' ',1)
      dir_dict = FIELD(tcl_stmt,' ',2)
      IF dir_dict = '' THEN
         CRT
         CRT 'Usage:   ':repo_verb:' filename'
         CRT
         CRT '          Where filename is either a DIR type file or file where DICT is to be in repo.'
         CRT
         STOP
      END
*
*** Initialize
*
      PROMPT ''
*
*** determine if DIR file or D_ file
*
      OPEN 'VOC' TO filevar_voc ELSE
         CRT
         CRT '[001] Cannot open VOC file'
         CRT
         STOP
      END
      READ record_voc from filevar_voc,dir_dict ELSE
         CRT
         CRT '[002] Cannot read VOC "':dir_dict:'" to determine type'
         CRT
         STOP
      END
      linux_data = record_voc<2>
      linux_dict = record_voc<3>
      CRT 'File found... DATA level = ':linux_data:', DICT level = ':linux_dict
      EXECUTE 'sh -c "ls -ld ':linux_data:' 2> /dev/null"' CAPTURING data_type
      EXECUTE 'sh -c "ls -ld ':linux_dict:' 2> /dev/null"' CAPTURING dict_type
      BEGIN CASE
         CASE data_type[1,1] = 'd'
            dir_or_dict = 'DIR'
         CASE INDEX(data_type,'-> ',1)
            CRT
            CRT '[003] DIR file ':dir_dict:' is already in repo'
            CRT
            STOP
         CASE dict_type[1,1] = '-'
            dir_or_dict = 'DICT'
         CASE INDEX(dict_type,'-> ',1)
            CRT
            CRT '[004] DICT of  file ':dir_dict:' is already in repo'
            CRT
            STOP
         CASE 1
            CRT
            CRT '[005] ':dir_dict:' does not appear to be a DIR file or have a valid DICT level'
            CRT
            CRT '[[[[ ':data_type:' ]]]]'
            CRT '[[[[ ':dict_type:' ]]]]'
            CRT
            STOP
      END CASE
      CRT 'This is a ':dir_or_dict:' type file to move to repo'
*
*** Set/get repo directory
*
      EXECUTE 'sh -c "ls -l"' CAPTURING acct_ls
      repo_check = 0 ; last_repo = 0 ; all_repos = ''
      LOOP
         repo_check += 1
         repo_index = INDEX(acct_ls,'-> ',repo_check)
      UNTIL NOT(repo_index) DO
         this_repo = acct_ls[repo_index,LEN(acct_ls)]
         this_repo = this_repo<1>[4,LEN(acct_ls)]
         last_slash = COUNT(this_repo,'/')
         this_repo = OCONV(this_repo,'G0/':last_slash)
         LOCATE this_repo IN all_repos SETTING already_done ELSE
            last_repo += 1
            all_repos<last_repo> = this_repo
         END
      REPEAT
      BEGIN CASE
         CASE last_repo = 1
            CRT
            CRT 'Enter repo directory or <Enter> for "':all_repos<1>:'" : ':
            INPUT repo_dir
            IF repo_dir # '' THEN
               EXECUTE 'sh -c "ls -ld ':repo_dir:' 2> /dev/null"' CAPTURING repo_dir_ld
               IF repo_dir_ld[1,1] # 'd' THEN
                  CRT
                  CRT '[006] Not a valid directory - Aborted!'
                  CRT
                  STOP
               END
            END
         CASE last_repo = 0
            CRT
            CRT 'Enter repo directory : ':
            INPUT repo_dir
            IF repo_dir # '' THEN
               EXECUTE 'sh -c "ls -ld ':repo_dir:' 2> /dev/null"' CAPTURING repo_dir_ld
               IF repo_dir_ld[1,1] # 'd' THEN
                  CRT
                  CRT '[007] Not a valid directory - Aborted!'
                  CRT
                  STOP
               END
            END
         CASE 1
            CRT
            FOR repo_count = 1 TO last_repo
               CRT repo_count'R%2':'. ':all_repos<repo_count>
            NEXT repo_count
            CRT
            CRT 'Enter repo directory or number from above : ':
            INPUT repo_dir
            IF NUM(repo_dir) AND repo_dir LE last_repo THEN
               repo_dir = all_repos<repo_dir>
            END
            IF repo_dir # '' THEN
               EXECUTE 'sh -c "ls -ld ':repo_dir:' 2> /dev/null"' CAPTURING repo_dir_ld
               IF repo_dir_ld[1,1] # 'd' THEN
                  CRT
                  CRT '[008] Not a valid directory - Aborted!'
                  CRT
                  STOP
               END
            END
      END CASE
*
*** Process
*
      IF dir_or_dict = 'DIR' THEN
*
         EXECUTE 'sh -c "ls -ld ':repo_dir:'/':linux_data:' 2> /dev/null"' CAPTURING already_in_repo
         BEGIN CASE
            CASE already_in_repo[1,1] = 'd'
               CRT
               CRT 'DIR ':linux_data:' already exists in repo'
            CASE already_in_repo = ''
               EXECUTE 'sh -c "mkdir -m775 ':repo_dir:'/':linux_data:'"' CAPTURING no_error
               IF LEN(no_error) THEN
                  CRT
                  CRT '[009] Cannot create DIR file ':linux_data:' in repo.  Aborted!'
                  CRT '[[[[ ':no_error:' ]]]]'
                  CRT
                  STOP
               END
               CRT 'DIR ':linux_data:' created in repo'
            CASE 1
               CRT
               CRT '[010] ':dir_dict:' in repo as non-dir.   Aborted!'
               CRT
               STOP
         END CASE
         EXECUTE 'sh -c "ls -ld ':repo_dir:'/':linux_data:' 2> /dev/null"' CAPTURING now_in_repo
         IF now_in_repo[1,1] # 'd' THEN
            CRT
            CRT '[011] Could not create directory in repo.  Aborted'
            CRT
            STOP
         END
*
*** Move to a temp location, create symbolic link, copy items to repo, remove temp location
*
         CRT 'Moving Linux directory ':linux_data:' to torepo_':linux_data
         EXECUTE 'sh -c "mv ':linux_data:' torepo_':linux_data:'"'
         CRT 'Creating symbolic link ':linux_data:' to ':repo_dir:'/':linux_data
         EXECUTE 'sh -c "ln -s ':repo_dir:'/':linux_data:' ':linux_data:'"'
         CRT 'Changing group to dshare in repo ':linux_data
         EXECUTE 'sh -c "chgrp -R dshare ':repo_dir:'/':linux_data:'"'
         CRT 'Moving any items in torepo_':linux_data:' to ':linux_data:' (repo link)'
         EXECUTE 'sh -c "mv torepo_':linux_data:'/* ':linux_data:'/."'
         EXECUTE 'sh -c "ls -1 torepo_':linux_data:'"' CAPTURING move_complete
         CONVERT CHAR(10):CHAR(13) TO @AM IN move_complete
         IF move_complete = '' THEN
            CRT 'Removing empty temporary directory torepo_':linux_data
            EXECUTE 'sh -c "rm -rf torep_':linux_data:'"'
         END ELSE
            CRT '[012] Could not remove torepo_':linux_data:', since items still exist'
            CRT '[[[[ ':move_complete:' ]]]]'
         END
         STOP
      END ELSE
*
         EXECUTE 'sh -c "ls -ld ':repo_dir:'/':linux_dict:' 2> /dev/null"' CAPTURING already_in_repo
         BEGIN CASE
            CASE already_in_repo[1,1] = 'd'
               CRT
               CRT 'DIR ':linux_dict:' already exists in repo'
            CASE already_in_repo = ''
               EXECUTE 'sh -c "mkdir -m775 ':repo_dir:'/':linux_dict:'"' CAPTURING no_error
               IF LEN(no_error) THEN
                  CRT
                  CRT '[013]] Cannot create a DIR in repo for the DICT of ':dir_dict:'. Aborted!'
                  CRT '[[[[ ':no_error:' ]]]]'
                  CRT
                  STOP
               END
               CRT 'DIR ':linux_dict:' created in repo'
            CASE 1
               CRT
               CRT '[014] ':dir_dict:' in repo as non-dir.   Aborted!'
               CRT
               STOP
         END CASE
         EXECUTE 'sh -c "ls -ld ':repo_dir:'/':linux_dict:' 2> /dev/null"' CAPTURING now_in_repo
         IF now_in_repo[1,1] # 'd' THEN
            CRT
            CRT '[015] Could not create directory in repo.  Aborted'
            CRT
            STOP
         END
*
*** Move to a temp location, create symbolic link, copy items to repo, remove temp location
*
         CRT 'Moving Linux hashed file ':linux_dict:' to torepo_':linux_dict
         EXECUTE 'sh -c "mv ':linux_dict:' torepo_':linux_dict:'"'
         CRT 'Creating symbolic link ':linux_dict:' to ':repo_dir:'/':linux_dict
         EXECUTE 'sh -c "ln -s ':repo_dir:'/':linux_dict:' ':linux_dict:'"'
         CRT 'Changing group to dshare in repo ':linux_dict
         EXECUTE 'sh -c "chgrp -R dshare ':repo_dir:'/':linux_dict:'"'
*
*** Create temp voc item and copy in UniVerse
*
         record_tvoc = 'F'
         record_tvoc<2> = linux_data
         record_tvoc<3> = 'torepo_':linux_dict
         READU lockit FROM filevar_voc,'torepo_tmpdict' LOCKED
            CRT
            CRT '[016] VOC item torepo_tmpdict is LOCKED.'
            CRT
            STOP
         END THEN NULL
         WRITEU record_tvoc ON filevar_voc,'torepo_tmpdict'
         OPEN 'DICT','torepo_tmpdict' TO dfilevar_torepo ELSE
            CRT
            CRT '[017] Cannot open dict torepo_tmpdict, which is pointer to old DICT ':dir_dict
            CRT
            CRT 'You may have to update DICT ':dir_dict:' by hand'
            CRT
            STOP
         END
         OPEN 'DICT',dir_dict TO dfilevar_onrepo ELSE
            CRT
            CRT '[018] Cannot open DICT ':dir_dict:', which is repo version of DICT ':dir_dict
            CRT
            CRT 'You may have to update DICT ':dir_dict:' by hand'
            CRT
            STOP
         END
         EXECUTE 'SSELECT DICT torepo_tmpdict' RTNLIST dict_list
         LOOP
            READNEXT dict_id FROM dict_list ELSE EXIT
            READ record_dict FROM dfilevar_torepo,dict_id THEN
               WRITE record_dict ON dfilevar_onrepo,dict_id
               DELETE dfilevar_torepo,dict_id
            END
         REPEAT
         EXECUTE 'COUNT torepo_tmpdict' CAPTURING move_complete
         CONVERT CHAR(10):CHAR(13):@AM TO '' IN move_complete
         EXECUTE 'SSELECT DICT torepo_tmpdict' RTNLIST empty_dict_list CAPTURING no_output
         READNEXT items_exist FROM empty_dict_list THEN
            CRT '[019] Could not remove torepo_':linux_dict:', since items still exist'
         END ELSE
            CRT 'Removing empty temporary directory torepo_':linux_dict
            EXECUTE 'sh -c "rm -rf torep_':linux_dict:'"'
            DELETE filevar_voc,'torepo_tmpdict'
         END
         STOP
      END
